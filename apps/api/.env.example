DATABASE_URL=postgresql://tnnd:tnnd@localhost:5432/tnnd
DB_SSL=false
DB_MAX_CONNECTIONS=10
# Set true only when TNND runs behind a trusted reverse proxy that sets X-Forwarded-Proto.
TNND_TRUST_PROXY=false
# Generate a 32-byte key for local/deployed environments, for example: openssl rand -base64 32
# Never commit the generated value.
TNND_SECRET_ENCRYPTION_KEY=
