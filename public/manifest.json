{
  "manifest_version": 3,
  "name": "TNND",
  "description": "A user-controlled dating message copilot with Gemini-powered reply suggestions.",
  "version": "0.1.0",
  "permissions": ["storage"],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "assets/background.js"
  },
  "action": {
    "default_title": "Open TNND"
  },
  "options_page": "options.html"
}
