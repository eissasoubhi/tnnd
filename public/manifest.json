{
  "manifest_version": 3,
  "name": "TNND",
  "description": "Gemini-powered Tinder auto-chat with configurable identity, style and language mix.",
  "version": "0.2.12",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://tinder.com/*",
    "https://www.tinder.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "assets/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://tinder.com/*",
        "https://www.tinder.com/*"
      ],
      "js": [
        "assets/content.js",
        "assets/chat-bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "assets/web-diagnostic-page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "assets/web-diagnostic-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Open TNND",
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
