{
  "name": "tnnd",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && npm run test:tinder-state && npm run test:human-action-resume && npm run test:match-profile-capture && npm run test:match-profile-runtime && node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test:tinder-state": "node --experimental-strip-types scripts/check-tinder-state-machine.mjs",
    "test:human-action-resume": "node --experimental-strip-types scripts/check-human-action-resume.mjs",
    "test:match-profile-capture": "node --experimental-strip-types scripts/check-match-profile-capture.mjs",
    "test:match-profile-runtime": "node scripts/check-match-profile-runtime.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.320",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
