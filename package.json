    "test:tinder-message-evidence": "node --experimental-strip-types --test scripts/check-tinder-message-evidence.mjs",
    "test:tinder-message-layout": "node --experimental-strip-types --test scripts/check-tinder-message-layout.mjs",
    "test:tinder-chat-identity": "node --experimental-strip-types --test scripts/check-tinder-chat-identity.mjs",
    "test:new-match-observation": "node --experimental-strip-types --test scripts/check-new-match-observation.mjs",
    "test:global-new-match-runner": "node --experimental-strip-types --test scripts/check-global-new-match-runner.mjs",
    "test:existing-match-opener": "node --experimental-strip-types --test scripts/check-existing-match-opener.mjs",
    "test:existing-match-preparation": "node --experimental-strip-types --test scripts/check-existing-match-preparation.mjs",
    "test:spa-first-message-permissions": "node --experimental-strip-types --test scripts/check-spa-first-message-permissions.mjs",
    "test:global-existing-runner": "node --experimental-strip-types --test scripts/check-global-existing-runner.mjs",
    "test:tinder-existing-index": "node --experimental-strip-types --test scripts/check-tinder-existing-index.mjs",
    "test:tinder-spa-runner": "node --experimental-strip-types --test scripts/check-tinder-spa-runner.mjs",
    "test:tinder-bridge-recovery": "node --experimental-strip-types --test scripts/check-tinder-bridge-recovery.mjs",
    "test:existing-chat-bulk-optin": "node --experimental-strip-types --test scripts/check-existing-chat-bulk-optin.mjs",
    "test:unanswered-backlog": "node --experimental-strip-types --test scripts/check-tinder-unanswered-backlog.mjs"
