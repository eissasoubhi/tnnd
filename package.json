    "test:visible-profile-panel": "node --experimental-strip-types --test scripts/check-tinder-visible-profile-panel.mjs",
    "test:extension-context": "node --experimental-strip-types scripts/check-extension-context-lifecycle.mjs",
    "test:web-diagnostics": "node --experimental-strip-types scripts/check-web-self-diagnostics.mjs",
    "test:extension-neo-bento": "node --test scripts/check-extension-neo-bento.test.mjs",
    "test:identity-setup": "node --experimental-strip-types scripts/check-identity-setup.mjs",
    "test:chat-detection": "node --experimental-strip-types scripts/check-tinder-chat-detection.mjs",
